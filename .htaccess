# Serve pages as UTF-8
AddDefaultCharset UTF-8

# Default document
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: send www to the bare domain (one hop, straight to HTTPS)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Force HTTPS (proxy-safe)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Old WordPress URLs -> new pages (anchored, won't touch real .html files)
  RewriteRule ^(about-us|about|about-the-firm|who-we-are)/?$ /about.html [R=301,L]
  RewriteRule ^(our-team|team|our-people|people|lawyers|advocates|attorneys)/?$ /people.html [R=301,L]
  RewriteRule ^(practice-areas|practice-area|practice|services|our-services|areas-of-practice|expertise|what-we-do)/?$ /practice.html [R=301,L]
  RewriteRule ^(contact-us|contact|get-in-touch|reach-us)/?$ /contact.html [R=301,L]
  RewriteRule ^(blog|news|news-and-events|news-events|events|publications|insights|articles)/?$ /news.html [R=301,L]
  RewriteRule ^(home|home-2|index\.php)/?$ / [R=301,L]

  # Old WordPress dated blog permalinks (/YYYY/MM/..., /YYYY/MM/DD/slug) -> News page
  RewriteRule ^[0-9]{4}/[0-9]{2}(/.*)?$ /news.html [R=301,L]
</IfModule>

# Always serve the current HTML/CSS/JS after a deploy (revalidate, still allows 304s)
<IfModule mod_headers.c>
  # Tell browsers to always use HTTPS for this site (so they never try http)
  Header set Strict-Transport-Security "max-age=2592000"
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Friendly 404
ErrorDocument 404 /404.html
